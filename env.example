# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_BASE_URL_AWS=https://w1887gqeij.execute-api.us-west-2.amazonaws.com/dev

# Google Maps API (Places Autocomplete en dirección personal; acepta también VITE_GOOGLE_MAPS_API_KEY)
# En Google Cloud: activar "Maps JavaScript API" + "Places API", facturación del proyecto, y restricción HTTP referrer (p. ej. http://localhost:5173/*).
VITE_GOOGLE_MAP_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Configuration
VITE_APP_NAME=NexoPay
VITE_APP_VERSION=1.0.0

# Misma clave que usa el backend para validar el HMAC del login.
# Si contiene $ o !, pon el valor entre comillas simples para que no se interprete como variable:
# VITE_APP_SECRET_KEY='tu_clave_con_$caracteres'
VITE_APP_SECRET_KEY=your_secret_key_here

# Environment
NODE_ENV=development
